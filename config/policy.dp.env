# config/policy.dp.env - the visuomotor diffusion policy (the default).
#
# How PolyUMI drives one policy fork: where it lives, what tag it builds as, which entrypoint the
# container runs. Sourced by build_policy_image.sh's policy_select(); select it with POLICY=dp
# (or by setting nothing at all). See docs/training-instructions.md "Choosing a policy".
#
# Hyperparameters are NOT here -- they are the fork's own Hydra tree. CONFIG_NAME only names which
# workspace yaml in that tree to run.

POLICY_DIR=external/polyumi_diffusion_policy
IMAGE=polyumi-dp
CONFIG_NAME=train_diffusion_unet_timm_polyumi_workspace
TRAIN_CMD="bash docker/train.sh"
SERVE_CMD="bash docker/serve.sh"
# Where train_policy.sh mounts $DATASET. Each fork's entrypoint has its own default dataset path,
# so mounting at that path means neither needs an override forwarded in; this one is what the
# polyumi task config defaults to.
DATASET_MNT=/data/dataset.zarr.zip
