<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>polyumi_ros2</name>
  <version>0.0.1</version>
  <description>Core ROS2 python nodes for the PolyUMI multimodal learning platform</description>
  <maintainer email="cwoodhayes@gmail.com">conorbot</maintainer>
  <license>MIT</license>

  <!-- ament_copyright / ament_flake8 / ament_pep257 were dropped: this repo lints Python with
       ruff (see pyproject.toml), and the ament defaults contradict it on line length and import
       order, so `colcon test` failed regardless of whether real tests passed. ament_xmllint
       stays — it validates package.xml against the ROS schema, which ruff does not do. -->
  <test_depend>ament_xmllint</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!-- The Franka stack (franka_bringup / franka_fr3_moveit_config) runs on the
       FR3 NUC under ROS2 Humble, NOT in this Kilted workspace. It is reached
       over DDS, so it is intentionally not a rosdep here. See docs/crb-fr3-inference.md. -->
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>v4l2_camera</exec_depend>
  <depend>polyumi_pi_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>foxglove_msgs</depend>
  <depend>tf2_ros</depend>
  <!-- Phase 2: when execute_motion is on, the node publishes each action chunk as a
       geometry_msgs/PoseArray on /polyumi/target_poses. The NUC-side fr3_moveit_bridge
       does the actual MoveIt calls — moveit_msgs is NOT needed on the laptop (large
       MoveIt action goals corrupt across the laptop/NUC rmw-version gap). -->
  <depend>geometry_msgs</depend>
  <!-- Phase 2.5: the gripper half of the action chunk goes out separately, as a
       trajectory_msgs/JointTrajectory on /polyumi/target_gripper. A PoseArray cannot carry a
       width, and the Franka Hand is action-only (no ros2_control interface), so it needs its
       own channel and its own cadence. Consumed by nuc/fr3_gripper_bridge.py — the franka_msgs
       gripper actions are called from the NUC, not here. -->
  <depend>trajectory_msgs</depend>
  <!-- latency_probe only: scipy carries the cross-correlation estimator in latency_util, and
       matplotlib draws the correlation curve you judge a marginal run by. Neither is on the
       inference path. The QR clock mode/=camera films needs no extra package — cv2 encodes and
       decodes it, and cv2 is already here for the camera preprocessing. -->
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
