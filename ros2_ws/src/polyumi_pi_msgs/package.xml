<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>polyumi_pi_msgs</name>
  <version>0.0.1</version>
  <description>Protobuf messages for communication with PolyTouch CE Finger</description>
  <maintainer email="cwoodhayes@gmail.com">conorbot</maintainer>
  <license>MIT</license>

  <buildtool_depend>python3-grpc-tools</buildtool_depend>
  <buildtool_depend>python3-protobuf</buildtool_depend>
  <buildtool_depend>protobuf-compiler</buildtool_depend>

  <!-- ament_copyright / ament_flake8 / ament_pep257 were dropped, as in polyumi_ros2: this repo
       lints Python with ruff (see pyproject.toml), and the ament defaults contradict it on line
       length and import order. Worse here, ament_flake8 lints the generated *_pb2.py protoc
       output, which can never be style-clean. ament_xmllint stays — it validates package.xml
       against the ROS schema, which ruff does not do. -->
  <test_depend>ament_xmllint</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
